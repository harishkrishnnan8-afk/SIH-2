# SIH26263 APAAR Platform Environment Configuration
# Copy this file to .env for local development

PROJECT_NAME="SIH26263 APAAR Platform API"
VERSION="1.0.0"
ENV="development"
DEBUG=true

# Database Connection
# SQLite (Zero setup for local evaluation):
DATABASE_URL="sqlite:///./apaar.db"
# PostgreSQL (Production ready):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/apaar_db"

# Security & Secrets (Change in production)
SECRET_KEY="sih26263-apaar-super-secret-dev-key-change-in-production-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=720

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8080","http://127.0.0.1:3000","http://127.0.0.1:5173","http://127.0.0.1:8080"]

# File Ingestion Limits
MAX_CSV_FILE_SIZE_MB=15
MAX_CSV_ROWS=10000

# Verification Mock Flag
SIMULATED_VERIFICATION_ONLY=true
